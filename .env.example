# RoadGuard AI environment configuration - safe example values only.
# Never put real secrets in this file.
# Phase 1 reads these from the process environment; this file documents
# the supported variable names.
#
# The V1 data/ML contract (300 segments, 48 months, 14,400 observations,
# 70/15/15 chronological split, 30-day maintenance window, risk bands
# 0-30/31-60/61-80/81-100) is locked and cannot be configured.
# Unknown ROADGUARD_* variables are rejected at load time.

ROADGUARD_ENV=development
ROADGUARD_SEED=42
ROADGUARD_DATA_DIR=data
ROADGUARD_ARTIFACTS_DIR=artifacts

# Optional: path to a YAML configuration file (reserved control variable).
# ROADGUARD_CONFIG_PATH=local.yaml
